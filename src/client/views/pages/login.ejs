<main class="min-h-screen bg-slate-50 relative overflow-hidden">
    <div class="absolute -top-20 -left-24 h-72 w-72 rounded-full bg-emerald-200/40 blur-3xl"></div>
    <div class="absolute -bottom-24 right-0 h-96 w-96 rounded-full bg-orange-200/50 blur-3xl"></div>
    <div class="absolute top-1/3 right-1/3 h-48 w-48 rounded-full bg-sky-200/40 blur-3xl"></div>

    <div class="relative z-10 mx-auto flex min-h-screen max-w-6xl flex-col lg:grid lg:grid-cols-2">
        <section class="hidden lg:flex flex-col justify-between p-12">
            <div>
                <div class="flex items-center gap-3">
                    <div class="flex size-16 items-center justify-center rounded-2xl bg-emerald-600 text-white shadow-lg">
                        <!-- <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2"></path>
                        </svg> -->
                        <img src="/api/image/apple-touch-icon.png" class="w-full" alt="StackDev">
                    </div>
                    <span class="text-2xl font-semibold text-slate-900 font-poppins">StackDev</span>
                </div>

                <div class="mt-14 max-w-md">
                    <p class="text-xs uppercase tracking-[0.3em] text-slate-500">Design system</p>
                    <h1 class="mt-4 text-4xl font-semibold text-slate-900 leading-tight font-poppins">
                        Everything your team ships, organized and ready to share.
                    </h1>
                    <p class="mt-5 text-base text-slate-600 leading-relaxed">
                        "This platform transformed how our designers manage huge assets. It is fast, calm, and dependable."
                    </p>
                    <div class="mt-6 flex items-center gap-3">
                        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 font-semibold">SD</span>
                        <div>
                            <p class="text-sm font-semibold text-slate-900">Sofia Davis</p>
                            <p class="text-xs text-slate-500">Lead Designer at Acme Inc.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- <div class="rounded-2xl border border-slate-200 bg-white/80 p-6 shadow-sm backdrop-blur">
                <p class="text-xs text-slate-500 uppercase tracking-[0.2em]">CloudBox Storage</p>
                <div class="mt-4 flex items-center justify-between">
                    <span class="text-2xl font-semibold text-slate-900">78%</span>
                    <span class="text-xs text-slate-500">4.2 GB of 5 GB</span>
                </div>
                <div class="mt-3 h-2 w-full rounded-full bg-slate-100">
                    <div class="h-2 w-[78%] rounded-full bg-linear-to-r from-emerald-500 via-amber-400 to-rose-400"></div>
                </div>
            </div> -->
        </section>

        <section class="flex items-center justify-center px-6 py-12">
            <div class="w-full max-w-md">
                <div class="rounded-2xl border border-slate-200 bg-white/90 p-8 shadow-[0_25px_60px_-40px_rgba(15,23,42,0.4)] backdrop-blur">
                    <div class="flex items-center gap-2 text-emerald-700">
                        <span class="text-xs font-semibold uppercase tracking-[0.35em]">Welcome back</span>
                        <span class="h-1 w-6 rounded-full bg-emerald-600"></span>
                    </div>
                    <h2 class="mt-4 text-3xl font-semibold text-slate-900 font-poppins">Sign in to StackDev</h2>
                    <p class="mt-2 text-sm text-slate-500">Enter your email or username to access your workspace.</p>

                    <form id="login-form" class="mt-6 space-y-4">
                        <input type="hidden" name="returnTo" value="<%= typeof returnTo !== 'undefined' ? returnTo : '/' %>">
                        <div class="gap-2 flex flex-col">
                            <label for="login-username" class="text-xs font-semibold uppercase tracking-wider text-slate-500">Email or Username</label>
                            <input id="login-username" name="username" type="text" autocomplete="username" required class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-800 shadow-sm focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100">
                        </div>
                        <div class="gap-2 flex flex-col">
                            <label for="login-password" class="text-xs font-semibold uppercase tracking-wider text-slate-500">Password</label>
                            <input id="login-password" name="password" type="password" autocomplete="current-password" required class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-800 shadow-sm focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100">
                        </div>
                        <div class="flex items-center justify-between text-xs">
                            <label class="inline-flex items-center gap-2 text-slate-500">
                                <input type="checkbox" class="h-4 w-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-200">
                                Remember me
                            </label>
                            <a href="#" class="text-emerald-700 hover:text-emerald-800">Forgot password?</a>
                        </div>
                        <button id="login-submit" type="submit" class="button bg-emerald-600 text-primary-foreground focus:ring-emerald-200">
                            Sign in with Email
                        </button>
                    </form>

                    <div id="login-error" class="mt-4 hidden rounded-2xl border border-rose-100 bg-rose-50 px-4 py-2 text-xs text-rose-600" role="alert"></div>

                    <div class="mt-6 flex items-center gap-3">
                        <div class="h-px flex-1 bg-slate-200"></div>
                        <span class="text-[10px] font-semibold tracking-[0.3em] text-slate-400">OR CONTINUE WITH</span>
                        <div class="h-px flex-1 bg-slate-200"></div>
                    </div>

                    <button type="button" class="mt-4 flex button items-center justify-center gap-2 border border-foreground/10 shadow-none">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.4c.58.11.79-.25.79-.56v-2.1c-3.21.7-3.89-1.38-3.89-1.38-.53-1.33-1.29-1.69-1.29-1.69-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.74.41-1.26.74-1.55-2.56-.29-5.26-1.28-5.26-5.72 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.48.11-3.08 0 0 .97-.31 3.18 1.18a10.86 10.86 0 0 1 5.8 0c2.21-1.5 3.17-1.18 3.17-1.18.63 1.6.23 2.79.11 3.08.74.81 1.19 1.84 1.19 3.1 0 4.45-2.71 5.42-5.29 5.7.42.36.79 1.07.79 2.16v3.2c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .5z"></path>
                        </svg>
                        GitHub
                    </button>

                    <p class="mt-6 text-xs text-slate-500">
                        Don't have an account? <a href="#" class="font-semibold text-emerald-700 hover:text-emerald-800">Sign up</a>
                    </p>
                    <p class="mt-3 text-[11px] text-slate-400">Privacy Policy | Terms of Service</p>
                </div>
            </div>
        </section>
    </div>
</main>

<script>
    (function () {
        const form = document.getElementById("login-form");
        const errorBox = document.getElementById("login-error");
        const submitButton = document.getElementById("login-submit");

        const setCookie = (name, value, expiresAt) => {
            const expires = expiresAt ? new Date(expiresAt).toUTCString() : "";
            const parts = [`${name}=${encodeURIComponent(value)}`, "Path=/", "SameSite=Lax"];
            if (expires) {
                parts.push(`Expires=${expires}`);
            }
            document.cookie = parts.join("; ");
        };

        if (!form) return;

        const setError = (message) => {
            if (!errorBox) return;
            errorBox.textContent = message;
            errorBox.classList.remove("hidden");
        };

        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            if (errorBox) {
                errorBox.classList.add("hidden");
                errorBox.textContent = "";
            }

            const formData = new FormData(form);
            const username = String(formData.get("username") || "");
            const password = String(formData.get("password") || "");
            const returnTo = String(formData.get("returnTo") || "/");

            if (submitButton) {
                submitButton.disabled = true;
                submitButton.textContent = "Signing in...";
            }

            try {
                const response = await fetch("/api/auth/login", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ username, password })
                });

                const data = await response.json().catch(() => null);

                if (!response.ok) {
                    setError(data?.message || "Login failed. Please try again.");
                    return;
                }

                const result = data?.result || data;

                if (result?.accessToken) {
                    localStorage.setItem("accessToken", result.accessToken);
                    setCookie("accessToken", result.accessToken, result?.expiresAt);
                }
                if (result?.refreshToken) {
                    localStorage.setItem("refreshToken", result.refreshToken);
                    setCookie("refreshToken", result.refreshToken, result?.refreshExpiresAt);
                }
                if (result?.user) {
                    localStorage.setItem("user", JSON.stringify(result.user));
                }

                if (returnTo && returnTo !== "/login") {
                    window.location.href = returnTo;
                } else {
                    window.location.href = "/";
                }
            } catch (error) {
                setError("Login failed. Please try again.");
            } finally {
                if (submitButton) {
                    submitButton.disabled = false;
                    submitButton.textContent = "Sign in with Email";
                }
            }
        });
    })();
</script>
