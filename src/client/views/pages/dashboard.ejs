<%
    // Helper function to format bytes
    function formatBytes(bytes) {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    // Calculate storage metrics
    const totalSizeGB = storageData ? storageData.totalSize / (1024 ** 3) : 0;
    const usedPercentage = storageData ? Math.min((totalSizeGB / maxStorageGB) * 100, 100) : 0;
    const freeGB = maxStorageGB - totalSizeGB;

    // Pre-calculate percentage values for use in script
    const imagesPercentage = categorizedData ? categorizedData.categories.images.percentage : 0;
    const documentsPercentage = categorizedData ? categorizedData.categories.documents.percentage : 0;
    const videosPercentage = categorizedData ? categorizedData.categories.videos.percentage : 0;
    const othersPercentage = categorizedData ? categorizedData.categories.others.percentage : 0;
%>

<main class="flex-1 overflow-y-auto bg-background">
    <%- include('../components/header') %>

    <div class="p-8">
        <!-- Storage Overview -->
        <section class="mb-10">
            <h2 class="text-xl font-bold text-slate-900 mb-6">Storage Overview</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Total Storage Card -->
                <div class="p-6 rounded-2xl bg-white">
                    <div class="flex justify-between items-start mb-6">
                        <div>
                            <h3 class="text-sm font-semibold text-foreground/60 mb-1">Total Storage</h3>
                            <div class="flex items-baseline gap-2">
                                <span class="text-3xl font-bold text-slate-900"><%= storageData ? storageData.totalSizeFormatted : '0 GB' %></span>
                                <span class="text-foreground/60 text-sm">used of <%= maxStorageGB %> GB</span>
                            </div>
                        </div>
                        <span class="px-2 py-1 bg-primary/5 text-primary text-[10px] font-bold rounded uppercase tracking-wider"><%= maxStorageGB %> GB Plan</span>
                    </div>
                    <div class="w-full h-3 bg-slate-100 rounded-full overflow-hidden mb-4">
                        <div class="h-full w-0 bg-linear-to-r from-green-500 via-orange-500 to-red-400 rounded-full transition-all duration-700 ease-out" data-used-percentage></div>
                    </div>
                    <div class="flex justify-between text-xs text-foreground/60 mb-6">
                        <span>Used: <%= storageData ? storageData.totalSizeFormatted : '0 GB' %></span>
                        <span>Free: <%= freeGB.toFixed(2) %> GB</span>
                    </div>
                    <div class="grid grid-cols-3 gap-3">
                        <div class="p-3 bg-slate-50 rounded-xl">
                            <p class="text-[10px] text-foreground/60 font-medium uppercase mb-1">Images</p>
                            <p class="text-sm font-bold"><%= categorizedData ? formatBytes(categorizedData.categories.images.size) : '0 GB' %></p>
                        </div>
                        <div class="p-3 bg-slate-50 rounded-xl">
                            <p class="text-[10px] text-foreground/60 font-medium uppercase mb-1">Documents</p>
                            <p class="text-sm font-bold"><%= categorizedData ? formatBytes(categorizedData.categories.documents.size) : '0 GB' %></p>
                        </div>
                        <div class="p-3 bg-slate-50 rounded-xl">
                            <p class="text-[10px] text-foreground/60 font-medium uppercase mb-1">Videos</p>
                            <p class="text-sm font-bold"><%= categorizedData ? formatBytes(categorizedData.categories.videos.size) : '0 GB' %></p>
                        </div>
                    </div>
                </div>

                <!-- Breakdown Card -->
                <div class="p-6 rounded-2xl bg-white ">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-sm font-bold text-slate-900">File Types Breakdown</h3>
                        <span class="text-xs text-slate-400">By storage used</span>
                    </div>
                    <div class="flex gap-8">
                        <div class="space-y-4 flex-1">
                            <div class="space-y-1">
                                <div class="flex justify-between items-center text-xs">
                                    <span class="font-medium">Images</span>
                                    <span class="text-slate-400"><%= categorizedData ? formatBytes(categorizedData.categories.images.size) : '0 GB' %></span>
                                </div>
                                <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
                                    <div class="bg-primary w-0 h-full rounded-full transition-all duration-700 ease-out" data-images-percentage>
                                </div>
                            </div>
                            <div class="space-y-1">
                                <div class="flex justify-between items-center text-xs">
                                    <span class="font-medium">Documents</span>
                                    <span class="text-slate-400"><%= categorizedData ? formatBytes(categorizedData.categories.documents.size) : '0 GB' %></span>
                                </div>
                                <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
                                    <div class="bg-orange-500 w-0 h-full rounded-full transition-all duration-700 ease-out" data-documents-percentage>
                                </div>
                            </div>
                            <div class="space-y-1">
                                <div class="flex justify-between items-center text-xs">
                                    <span class="font-medium">Videos</span>
                                    <span class="text-slate-400"><%= categorizedData ? formatBytes(categorizedData.categories.videos.size) : '0 GB' %></span>
                                </div>
                                <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
                                    <div class="bg-green-500 w-0 h-full rounded-full transition-all duration-700 ease-out" data-videos-percentage>
                                </div>
                            </div>
                            <div class="space-y-1">
                                <div class="flex justify-between items-center text-xs">
                                    <span class="font-medium">Others</span>
                                    <span class="text-slate-400"><%= categorizedData ? formatBytes(categorizedData.categories.others.size) : '0 GB' %></span>
                                </div>
                                <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
                                    <div class="bg-orange-300 w-0 h-full rounded-full transition-all duration-700 ease-out" data-others-percentage>
                                </div>
                            </div>
                        </div>
                        <div class="space-y-2">
                            <div class="flex items-center gap-2 text-xs text-slate-500">
                                <span class="w-2 h-2 rounded-full bg-primary"></span> Images <span class="ml-auto font-bold"><%= categorizedData ? Math.round(categorizedData.categories.images.percentage) : 0 %>%</span>
                            </div>
                            <div class="flex items-center gap-2 text-xs text-slate-500">
                                <span class="w-2 h-2 rounded-full bg-orange-500"></span> Documents <span class="ml-auto font-bold"><%= categorizedData ? Math.round(categorizedData.categories.documents.percentage) : 0 %>%</span>
                            </div>
                            <div class="flex items-center gap-2 text-xs text-slate-500">
                                <span class="w-2 h-2 rounded-full bg-green-500"></span> Videos <span class="ml-auto font-bold"><%= categorizedData ? Math.round(categorizedData.categories.videos.percentage) : 0 %>%</span>
                            </div>
                            <div class="flex items-center gap-2 text-xs text-slate-500">
                                <span class="w-2 h-2 rounded-full bg-orange-300"></span> Others <span class="ml-auto font-bold"><%= categorizedData ? Math.round(categorizedData.categories.others.percentage) : 0 %>%</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Quick Access -->
        <section class="mb-10">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-xl font-bold text-slate-900">Quick Access</h2>
                <div class="flex gap-4">
                    <button class="text-primary text-sm font-semibold hover:underline">View all</button>
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <%
                    const folderIcon = '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>';
                    const topFolders = storageData && storageData.folderBreakdown ? storageData.folderBreakdown.slice(0, 4) : [];

                    const quickAccessItems = topFolders.map(folder => ({
                        icon: folderIcon,
                        title: folder.name,
                        label: 'Folder',
                        size: folder.formattedSize,
                        fileCount: `${folder.fileCount} files`,
                        updated: 'Recent',
                        className: 'bg-primary/10 text-primary'
                    }));
                %>
                <% quickAccessItems.forEach((item) => { %>
                    <%- include('../components/quick-access-item', item) %>
                <% }); %>
            </div>
        </section>

        <!-- File Types Details -->
        <section>
            <h2 class="text-xl font-bold text-slate-900 mb-6">File Types Details</h2>
            <%
                const tableHeaders = ['Type', 'Total Files', 'Storage Used', 'Average Size', 'Share of Total'];
                const tableIcons = {
                    'Images (JPG, PNG, SVG)': '<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>',
                    'Documents (PDF, DOCX)': '<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>',
                    'Videos (MP4, MOV)': '<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>',
                    'Archives (ZIP, RAR)': '<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>',
                    'Code & Others': '<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>'
                };
                const tableBgColors = {
                    'Images (JPG, PNG, SVG)': 'bg-primary/10 text-primary',
                    'Documents (PDF, DOCX)': 'bg-orange-500/10 text-orange-600',
                    'Videos (MP4, MOV)': 'bg-green-500/10 text-green-600',
                    'Archives (ZIP, RAR)': 'bg-primary/10 text-primary',
                    'Code & Others': 'bg-foreground/5 text-slate-600'
                };

                const tableRows = categorizedData ? categorizedData.tableData.map(item => ({
                    icon: tableIcons[item.name],
                    iconClassName: tableBgColors[item.name],
                    name: item.name,
                    totalFiles: item.count.toLocaleString(),
                    storageUsed: formatBytes(item.size),
                    averageSize: item.count > 0 ? formatBytes(item.size / item.count) : '0 Bytes',
                    shareOfTotal: Math.round(item.percentage) + '%'
                })) : [];
            %>
            <%- include('../components/table', { headers: tableHeaders, rows: tableRows }) %>
        </section>
    </div>
</main>

<script>
    const usedPercentage = document.querySelector('[data-used-percentage]');
    usedPercentage.style.width = "<%= usedPercentage.toFixed(1) %>%";

    const imagesPercentage = document.querySelector('[data-images-percentage]');
    imagesPercentage.style.width = "<%= imagesPercentage.toFixed(1) %>%";

    const documentsPercentage = document.querySelector('[data-documents-percentage]');
    documentsPercentage.style.width = "<%= documentsPercentage.toFixed(1) %>%";

    const videosPercentage = document.querySelector('[data-videos-percentage]');
    videosPercentage.style.width = "<%= videosPercentage.toFixed(1) %>%";

    const othersPercentage = document.querySelector('[data-others-percentage]');
    othersPercentage.style.width = "<%= othersPercentage.toFixed(1) %>%";
</script>