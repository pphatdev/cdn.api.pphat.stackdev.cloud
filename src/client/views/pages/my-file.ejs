<main class="flex-1 overflow-y-auto bg-background relative">
    <%- include('../components/header') %>

    <!-- MY FILES VIEW -->
    <div id="view-my-files" class="p-8">
        <!-- Breadcrumbs & Title Bar -->
        <div class="flex items-center gap-4 text-xs text-slate-400 mb-6">
            <div class="flex items-center cursor-pointer hover:text-slate-600">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            </div>
            <span class="breadcrumb-item cursor-pointer hover:text-slate-600">My Files</span>
            <span class="breadcrumb-item font-semibold text-slate-900">Design System</span>
        </div>

        <div class="flex items-center justify-between mb-8">
            <div class="flex items-center gap-4">
                <div class="p-3 bg-primary/5 text-primary rounded-xl">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-slate-900">Design System</h1>
                    <p class="text-sm text-slate-400">21 Files, 5 Folders • 4.2 GB • Last modified 2h ago</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex -space-x-2 mr-4">
                    <img class="w-8 h-8 rounded-full border-2 border-white" src="https://ui-avatars.com/api/?name=JD&background=ef4444&color=fff" alt="">
                    <img class="w-8 h-8 rounded-full border-2 border-white" src="https://ui-avatars.com/api/?name=AM&background=f59e0b&color=fff" alt="">
                    <img class="w-8 h-8 rounded-full border-2 border-white" src="https://ui-avatars.com/api/?name=SL&background=10b981&color=fff" alt="">
                    <div class="w-8 h-8 rounded-full border-2 border-white bg-slate-100 flex items-center justify-center text-[10px] font-bold text-slate-500">+4</div>
                </div>
                <button class="px-4 py-2 border border-slate-200 rounded-lg text-sm font-semibold flex items-center gap-2 hover:bg-slate-50">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
                    Share
                </button>
                <button class="px-4 py-2 border border-slate-200 rounded-lg text-sm font-semibold flex items-center gap-2 hover:bg-slate-50">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                    Download
                </button>
                <button class="px-4 py-2 bg-primary text-white rounded-lg text-sm font-semibold flex items-center gap-2 hover:bg-primary/70 shadow-sm shadow-primary-100">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    New Item
                </button>
            </div>
        </div>

        <!-- Filters & Controls -->
        <div class="flex items-center justify-between mb-8 border-b border-slate-100 pb-4">
            <div class="flex items-center gap-4">
                <button class="flex items-center gap-2 text-sm font-medium px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
                    Type: All
                </button>
                <button class="flex items-center gap-2 text-sm font-medium px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    Date Modified
                </button>
            </div>
            <div class="flex items-center bg-slate-50 p-1 rounded-lg border border-slate-200">
                <button class="p-1.5 bg-white shadow-sm rounded-md text-primary">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                </button>
                <button class="p-1.5 text-slate-400 hover:text-slate-600">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
            </div>
        </div>

        <!-- Folders Section -->
        <div class="mb-12">
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-6">Folders</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <%- include('../components/folder-card', { title: '01. Assets', count: '128 files', icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>', className: 'bg-primary/5' }) %>
                <%- include('../components/folder-card', { title: '02. Components', count: '45 files', icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>', className: 'bg-primary/5' }) %>
                <%- include('../components/folder-card', { title: '03. Templates', count: '12 files', icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>', className: 'bg-primary/5' }) %>
                <%- include('../components/folder-card', { title: 'Documentation', count: '8 files', icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>', className: 'bg-primary/5' }) %>
            </div>
        </div>

        <!-- Files Section -->
        <div>
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-6">Files</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
                <%
                    const fileCards = [
                        {
                            thumbnail: '<img src="/api/image/example.png?w=200&h=200" alt="File Thumbnail" class="w-full h-full object-cover">',
                            icon: '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>',
                            className: 'bg-orange-50',
                            title: 'Color_Tokens_V2.fig',
                            subtitle: 'Edited 2h ago'
                        }
                    ];
                %>
                <% fileCards.forEach(card => { %>
                    <%- include('../components/file-card', { thumbnail: card.thumbnail, icon: card.icon, className: card.className, title: card.title, subtitle: card.subtitle, moreIcon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01"></path></svg>' }) %>
                <% });%>
            </div>
        </div>
    </div>
</main>