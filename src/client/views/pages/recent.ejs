<main class="flex-1 overflow-y-auto bg-background relative">
    <%- include('../components/header') %>

    <div class="max-w-7xl w-full lg:mx-auto max-sm:p-5 p-8">
        <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between mb-8">
            <div>
                <%- include('../components/breadcrumbs', {
                    items: [
                        {
                            label: 'Dashboard',
                            href: '/',
                            icon: '<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>'
                        },
                        { label: 'Recent' }
                    ]
                }) %>
                <h1 class="text-2xl mt-4 font-bold text-slate-900">Recent Files</h1>
                <p class="text-sm text-slate-500">View your recently accessed and uploaded files.</p>
            </div>
            <div class="flex items-center gap-3">
                <button id="view-toggle" type="button" class="button py-2 bg-white border shadow-none border-slate-200 text-slate-700 hover:bg-slate-50 flex items-center gap-2">
                    <svg id="view-icon-grid" class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                    <svg id="view-icon-list" class="size-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
                    <span id="view-label">Grid</span>
                </button>
                <a href="/files" class="button py-2 bg-primary whitespace-nowrap text-primary-foreground hover:bg-primary/80">Browse all files</a>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
            <div class="lg:col-span-3 space-y-6">
                <!-- Filters -->
                <div class="bg-white rounded-2xl border border-slate-100 p-4">
                    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                        <div class="relative w-full md:max-w-sm">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                            </span>
                            <input id="recent-search" type="text" placeholder="Search recent files..." class="w-full pl-9 pr-4 py-2 text-sm border border-slate-200 rounded-lg bg-white" />
                        </div>
                        <div class="flex items-center gap-3">
                            <select id="recent-filter" class="px-3 py-2 text-sm border border-slate-200 rounded-lg bg-white">
                                <option value="all" selected>All types</option>
                                <option value="images">Images</option>
                                <option value="documents">Documents</option>
                                <option value="videos">Videos</option>
                                <option value="archives">Archives</option>
                                <option value="others">Others</option>
                            </select>
                            <select id="recent-period" class="px-3 py-2 text-sm border border-slate-200 rounded-lg bg-white">
                                <option value="all">All time</option>
                                <option value="today" selected>Today</option>
                                <option value="week">This week</option>
                                <option value="month">This month</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Today Section -->
                <section id="section-today" class="hidden">
                    <h2 class="text-lg font-semibold text-slate-900 mb-4 flex items-center gap-2">
                        <svg class="size-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        Today
                    </h2>
                    <div id="grid-today" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
                    <div id="list-today" class="hidden bg-white rounded-2xl border border-slate-100 overflow-hidden"></div>
                </section>

                <!-- Yesterday Section -->
                <section id="section-yesterday" class="hidden">
                    <h2 class="text-lg font-semibold text-slate-900 mb-4 flex items-center gap-2">
                        <svg class="size-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        Yesterday
                    </h2>
                    <div id="grid-yesterday" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
                    <div id="list-yesterday" class="hidden bg-white rounded-2xl border border-slate-100 overflow-hidden"></div>
                </section>

                <!-- This Week Section -->
                <section id="section-week" class="hidden">
                    <h2 class="text-lg font-semibold text-slate-900 mb-4 flex items-center gap-2">
                        <svg class="size-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        This Week
                    </h2>
                    <div id="grid-week" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
                    <div id="list-week" class="hidden bg-white rounded-2xl border border-slate-100 overflow-hidden"></div>
                </section>

                <!-- Older Section -->
                <section id="section-older" class="hidden">
                    <h2 class="text-lg font-semibold text-slate-900 mb-4 flex items-center gap-2">
                        <svg class="size-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                        Older
                    </h2>
                    <div id="grid-older" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
                    <div id="list-older" class="hidden bg-white rounded-2xl border border-slate-100 overflow-hidden"></div>
                </section>

                <!-- Empty State -->
                <div id="empty-state" class="hidden bg-white rounded-2xl border border-slate-100 p-12 text-center">
                    <div class="mx-auto w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mb-4">
                        <svg class="size-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    </div>
                    <h3 class="text-lg font-semibold text-slate-900 mb-2">No recent files</h3>
                    <p class="text-sm text-slate-500 mb-6">Upload some files to see them here.</p>
                    <a href="/upload" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-white bg-primary rounded-lg hover:bg-primary/80">
                        <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                        Upload files
                    </a>
                </div>

                <!-- Loading State -->
                <div id="loading-state" class="bg-white rounded-2xl border border-slate-100 p-12 text-center">
                    <div class="mx-auto w-8 h-8 border-2 border-primary border-t-transparent rounded-full animate-spin mb-4"></div>
                    <p class="text-sm text-slate-500">Loading recent files...</p>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <div class="bg-white rounded-2xl border border-slate-100 p-6">
                    <h3 class="text-lg font-semibold text-slate-900 mb-4">Summary</h3>
                    <div class="space-y-3 text-sm text-slate-600">
                        <div class="flex items-center justify-between">
                            <span>Total files</span>
                            <span id="summary-total" class="font-semibold text-slate-900">0</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span>Total size</span>
                            <span id="summary-size" class="font-semibold text-slate-900">0 KB</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span>Latest</span>
                            <span id="summary-latest" class="font-semibold text-slate-900">—</span>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-slate-100 p-6">
                    <h3 class="text-lg font-semibold text-slate-900 mb-4">Quick Actions</h3>
                    <div class="space-y-2">
                        <a href="/upload" class="flex items-center gap-3 px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 rounded-lg transition-colors">
                            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                            Upload new files
                        </a>
                        <a href="/upload/history" class="flex items-center gap-3 px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 rounded-lg transition-colors">
                            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            Upload history
                        </a>
                        <a href="/files" class="flex items-center gap-3 px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 rounded-lg transition-colors">
                            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
                            Browse all files
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script type="module">
    import { authProvider } from '/utils/auth.js';

    // Elements
    const recentSearch = document.getElementById('recent-search');
    const recentFilter = document.getElementById('recent-filter');
    const recentPeriod = document.getElementById('recent-period');
    const viewToggle = document.getElementById('view-toggle');
    const viewLabel = document.getElementById('view-label');
    const viewIconGrid = document.getElementById('view-icon-grid');
    const viewIconList = document.getElementById('view-icon-list');
    const loadingState = document.getElementById('loading-state');
    const emptyState = document.getElementById('empty-state');
    const summaryTotal = document.getElementById('summary-total');
    const summarySize = document.getElementById('summary-size');
    const summaryLatest = document.getElementById('summary-latest');

    // State
    let allFiles = [];
    let viewMode = 'grid';

    // Type groups
    const typeGroups = {
        images: ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp', 'svg', 'ico'],
        documents: ['pdf', 'doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx', 'txt', 'rtf', 'odt'],
        videos: ['mp4', 'mov', 'avi', 'mkv', 'flv', 'wmv', 'webm'],
        archives: ['zip', 'rar', '7z', 'tar', 'gz']
    };

    const typeIcons = {
        images: '<svg class="size-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>',
        documents: '<svg class="size-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>',
        videos: '<svg class="size-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>',
        archives: '<svg class="size-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>',
        others: '<svg class="size-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>'
    };

    const typeColors = {
        images: 'bg-primary/10 text-primary',
        documents: 'bg-orange-500/10 text-orange-600',
        videos: 'bg-green-500/10 text-green-600',
        archives: 'bg-purple-500/10 text-purple-600',
        others: 'bg-slate-100 text-slate-600'
    };

    // Utilities
    const formatBytes = (bytes) => {
        if (!bytes) return '0 KB';
        const sizes = ['Bytes', 'KB', 'MB', 'GB'];
        const i = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), sizes.length - 1);
        return `${(bytes / Math.pow(1024, i)).toFixed(1)} ${sizes[i]}`;
    };

    // Auth helpers removed as they are handled by AuthProvider

    const timeAgo = (isoString) => {
        if (!isoString) return '—';
        const time = new Date(isoString).getTime();
        const now = Date.now();
        const diff = Math.max(now - time, 0);
        const seconds = Math.floor(diff / 1000);
        if (seconds < 60) return `${seconds}s ago`;
        const minutes = Math.floor(seconds / 60);
        if (minutes < 60) return `${minutes}m ago`;
        const hours = Math.floor(minutes / 60);
        if (hours < 24) return `${hours}h ago`;
        const days = Math.floor(hours / 24);
        if (days < 7) return `${days}d ago`;
        return new Date(isoString).toLocaleDateString();
    };

    const getFileType = (extension = '') => {
        const ext = extension.toLowerCase();
        if (typeGroups.images.includes(ext)) return 'images';
        if (typeGroups.documents.includes(ext)) return 'documents';
        if (typeGroups.videos.includes(ext)) return 'videos';
        if (typeGroups.archives.includes(ext)) return 'archives';
        return 'others';
    };

    const isToday = (date) => {
        const today = new Date();
        return date.toDateString() === today.toDateString();
    };

    const isYesterday = (date) => {
        const yesterday = new Date();
        yesterday.setDate(yesterday.getDate() - 1);
        return date.toDateString() === yesterday.toDateString();
    };

    const isThisWeek = (date) => {
        const now = new Date();
        const weekAgo = new Date();
        weekAgo.setDate(weekAgo.getDate() - 7);
        return date >= weekAgo && date <= now && !isToday(date) && !isYesterday(date);
    };

    // Categorize files by date
    const categorizeFiles = (files) => {
        const categories = { today: [], yesterday: [], week: [], older: [] };

        files.forEach(file => {
            const date = new Date(file.uploadedAt || file.createdAt);
            if (isToday(date)) {
                categories.today.push(file);
            } else if (isYesterday(date)) {
                categories.yesterday.push(file);
            } else if (isThisWeek(date)) {
                categories.week.push(file);
            } else {
                categories.older.push(file);
            }
        });

        return categories;
    };

    // Render file card HTML
    const renderFileCard = (file, index) => {
        const fileType = getFileType(file.extension);
        const isImage = fileType === 'images';
        const dropdownId = `recent-dropdown-${file.id || index}-${Math.random().toString(36).slice(2, 6)}`;

        return `
        <div class="rounded-2xl relative bg-white hover:shadow-lg shadow-primary/10 transition-all duration-300 overflow-hidden group border border-foreground/10">
            <div class="relative aspect-video bg-slate-50 flex items-center justify-center">
                ${isImage ? `
                    <img src="/api/image/assets/${encodeURIComponent(file.filename)}?fm=webp&q=80&w=250&fit=cover" alt="${file.originalFilename || file.filename}" loading="lazy" class="w-full bg-primary/5 h-full object-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="hidden items-center justify-center w-full h-full ${typeColors[fileType]}">
                        ${typeIcons[fileType]}
                    </div>
                ` : `
                    <div class="flex items-center justify-center w-full h-full ${typeColors[fileType]}">
                        ${typeIcons[fileType]}
                    </div>
                `}
                <div class="absolute z-20 top-3 right-3">
                    <button type="button" data-dropdown-toggle="${dropdownId}" data-dropdown-placement="bottom-end" aria-expanded="false" class="p-2 bg-white rounded-lg opacity-0 focus-within:opacity-100 group-hover:opacity-100 transition-all duration-300 shadow-sm cursor-pointer">
                        <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01"></path></svg>
                    </button>
                    <div id="${dropdownId}" class="hidden absolute right-0 mt-2 w-44 rounded-xl border border-slate-100 bg-white shadow-lg p-2 z-50 text-sm">
                        <a href="/api/file/preview/${file.filename}" class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-slate-50">
                            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                            Preview
                        </a>
                        <a href="/api/file/${file.filename}" download class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-slate-50">
                            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4 4m0 0l-4-4m4 4V4"></path></svg>
                            Download
                        </a>
                        <button type="button" class="w-full text-left flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-slate-50" data-action="copy" data-url="/api/file/${file.filename}">
                            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                            Copy URL
                        </button>
                        <div class="h-px bg-slate-100 my-1"></div>
                        <button type="button" class="w-full text-left flex items-center gap-2 px-3 py-2 rounded-lg text-red-600 hover:bg-red-50" data-action="delete" data-filename="${file.filename}">
                            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            Delete
                        </button>
                    </div>
                </div>
            </div>
            <div class="p-4">
                <h4 class="text-sm font-bold text-slate-900 mb-1 truncate" title="${file.originalFilename || file.filename}">${file.originalFilename || file.filename}</h4>
                <p class="text-xs text-foreground/60">${formatBytes(file.size)} · ${timeAgo(file.uploadedAt)}</p>
            </div>
            <a href="/detail?file=${file.filename}" class="absolute inset-0 z-10 cursor-pointer"></a>
        </div>
        `;
    };

    // Render list row HTML
    const renderListRow = (file, index) => {
        const fileType = getFileType(file.extension);
        const dropdownId = `recent-list-dropdown-${file.id || index}-${Math.random().toString(36).slice(2, 6)}`;

        return `
        <div class="flex items-center justify-between p-4 hover:bg-slate-50 border-b border-slate-100 last:border-b-0 group relative">
            <div class="flex items-center gap-4 min-w-0">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center ${typeColors[fileType]}">
                    <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                </div>
                <div class="min-w-0">
                    <a href="/api/file/preview/${file.filename}" class="text-sm font-semibold text-slate-900 hover:underline truncate block">${file.originalFilename || file.filename}</a>
                    <p class="text-xs text-slate-400">${file.folderPath || 'root'}</p>
                </div>
            </div>
            <div class="flex items-center gap-6">
                <span class="text-sm text-slate-500 whitespace-nowrap hidden sm:block">${formatBytes(file.size)}</span>
                <span class="text-sm text-slate-500 whitespace-nowrap hidden md:block">${timeAgo(file.uploadedAt)}</span>
                <div class="relative">
                    <button type="button" data-dropdown-toggle="${dropdownId}" data-dropdown-placement="bottom-end" aria-expanded="false" class="p-2 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors">
                        <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01"></path></svg>
                    </button>
                    <div id="${dropdownId}" class="hidden absolute right-0 mt-2 w-44 rounded-xl border border-slate-100 bg-white shadow-lg p-2 z-50 text-sm">
                        <a href="/api/file/preview/${file.filename}" class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-slate-50">
                            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                            Preview
                        </a>
                        <a href="/api/file/${file.filename}" download class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-slate-50">
                            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4 4m0 0l-4-4m4 4V4"></path></svg>
                            Download
                        </a>
                        <button type="button" class="w-full text-left flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-slate-50" data-action="copy" data-url="/api/file/${file.filename}">
                            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                            Copy URL
                        </button>
                        <div class="h-px bg-slate-100 my-1"></div>
                        <button type="button" class="w-full text-left flex items-center gap-2 px-3 py-2 rounded-lg text-red-600 hover:bg-red-50" data-action="delete" data-filename="${file.filename}">
                            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
        `;
    };

    // Render section
    const renderSection = (sectionId, files, startIndex = 0) => {
        const section = document.getElementById(`section-${sectionId}`);
        const gridContainer = document.getElementById(`grid-${sectionId}`);
        const listContainer = document.getElementById(`list-${sectionId}`);

        if (!section || !gridContainer || !listContainer) return;

        if (files.length === 0) {
            section.classList.add('hidden');
            return;
        }

        section.classList.remove('hidden');

        if (viewMode === 'grid') {
            gridContainer.classList.remove('hidden');
            listContainer.classList.add('hidden');
            gridContainer.innerHTML = files.map((file, i) => renderFileCard(file, startIndex + i)).join('');
        } else {
            gridContainer.classList.add('hidden');
            listContainer.classList.remove('hidden');
            listContainer.innerHTML = files.map((file, i) => renderListRow(file, startIndex + i)).join('');
        }
    };

    // Apply filters
    const applyFilters = () => {
        let filtered = [...allFiles];
        const query = recentSearch?.value?.trim().toLowerCase() || '';
        const filter = recentFilter?.value || 'all';
        const period = recentPeriod?.value || 'all';

        // Search filter
        if (query) {
            filtered = filtered.filter(file =>
                (file.originalFilename || file.filename || '').toLowerCase().includes(query) ||
                (file.extension || '').toLowerCase().includes(query)
            );
        }

        // Type filter
        if (filter !== 'all') {
            filtered = filtered.filter(file => getFileType(file.extension) === filter);
        }

        // Period filter
        if (period !== 'all') {
            filtered = filtered.filter(file => {
                const date = new Date(file.uploadedAt || file.createdAt);
                if (period === 'today') return isToday(date);
                if (period === 'week') return isToday(date) || isYesterday(date) || isThisWeek(date);
                if (period === 'month') {
                    const monthAgo = new Date();
                    monthAgo.setMonth(monthAgo.getMonth() - 1);
                    return date >= monthAgo;
                }
                return true;
            });
        }

        // Sort by date (newest first)
        filtered.sort((a, b) => new Date(b.uploadedAt).getTime() - new Date(a.uploadedAt).getTime());

        return filtered;
    };

    // Render all
    const render = () => {
        const filtered = applyFilters();
        const categories = categorizeFiles(filtered);

        loadingState?.classList.add('hidden');

        if (filtered.length === 0) {
            emptyState?.classList.remove('hidden');
            document.getElementById('section-today')?.classList.add('hidden');
            document.getElementById('section-yesterday')?.classList.add('hidden');
            document.getElementById('section-week')?.classList.add('hidden');
            document.getElementById('section-older')?.classList.add('hidden');
        } else {
            emptyState?.classList.add('hidden');
            let idx = 0;
            renderSection('today', categories.today, idx); idx += categories.today.length;
            renderSection('yesterday', categories.yesterday, idx); idx += categories.yesterday.length;
            renderSection('week', categories.week, idx); idx += categories.week.length;
            renderSection('older', categories.older, idx);
        }

        // Update summary
        updateSummary(filtered);

        // Initialize dropdowns
        initDropdowns();
    };

    // Update summary
    const updateSummary = (files) => {
        const totalSize = files.reduce((sum, file) => sum + (file.size || 0), 0);
        if (summaryTotal) summaryTotal.textContent = files.length.toString();
        if (summarySize) summarySize.textContent = formatBytes(totalSize);
        if (summaryLatest) summaryLatest.textContent = files.length ? timeAgo(files[0].uploadedAt) : '—';
    };

    // Initialize dropdowns
    const initDropdowns = () => {
        const popper = window.Popper;
        const createPopper = popper && popper.createPopper ? popper.createPopper : null;

        document.querySelectorAll('[data-dropdown-toggle]').forEach(triggerEl => {
            if (triggerEl.dataset.dropdownInitialized) return;
            triggerEl.dataset.dropdownInitialized = 'true';

            const targetId = triggerEl.getAttribute('data-dropdown-toggle');
            if (!targetId) return;

            const targetEl = document.getElementById(targetId);
            if (!targetEl) return;

            const placement = triggerEl.getAttribute('data-dropdown-placement') || 'bottom-end';
            new window.Dropdown(targetEl, triggerEl, { placement }, createPopper);
        });

        // Copy URL action
        document.querySelectorAll('[data-action="copy"]').forEach(btn => {
            if (btn.dataset.actionInitialized) return;
            btn.dataset.actionInitialized = 'true';

            btn.addEventListener('click', async () => {
                const url = btn.getAttribute('data-url');
                if (url) {
                    const fullUrl = window.location.origin + url;
                    await navigator.clipboard.writeText(fullUrl);
                    const original = btn.innerHTML;
                    btn.innerHTML = `<svg class="size-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Copied!`;
                    setTimeout(() => { btn.innerHTML = original; }, 1500);
                }
            });
        });

        // Delete action
        document.querySelectorAll('[data-action="delete"]').forEach(btn => {
            if (btn.dataset.actionInitialized) return;
            btn.dataset.actionInitialized = 'true';

            btn.addEventListener('click', async () => {
                const filename = btn.getAttribute('data-filename');
                if (filename && confirm('Are you sure you want to delete this file?')) {
                    try {
                        const res = await fetch(`/api/file/delete/${encodeURIComponent(filename)}`, { 
                            method: 'DELETE',
                            headers: authProvider.getAuthHeaders()
                        });
                        if (res.ok) {
                            loadFiles();
                        } else {
                            alert('Failed to delete file.');
                        }
                    } catch {
                        alert('Failed to delete file.');
                    }
                }
            });
        });
    };

    // Toggle view mode
    viewToggle?.addEventListener('click', () => {
        viewMode = viewMode === 'grid' ? 'list' : 'grid';
        if (viewLabel) viewLabel.textContent = viewMode === 'grid' ? 'Grid' : 'List';
        viewIconGrid?.classList.toggle('hidden', viewMode !== 'grid');
        viewIconList?.classList.toggle('hidden', viewMode !== 'list');
        render();
    });

    // Filter listeners
    recentSearch?.addEventListener('input', render);
    recentFilter?.addEventListener('change', render);
    recentPeriod?.addEventListener('change', render);

    // Load files
    const loadFiles = async () => {
        try {
            const response = await fetch('/api/database/files', {
                headers: authProvider.getAuthHeaders()
            });
            if (!response.ok) throw new Error('Failed to load files');
            const data = await response.json();
            allFiles = Array.isArray(data?.result) ? data.result : [];
            render();
        } catch (error) {
            loadingState?.classList.add('hidden');
            emptyState?.classList.remove('hidden');
        }
    };

    loadFiles();
</script>
