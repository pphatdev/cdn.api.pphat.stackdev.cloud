<!-- Quick Access Item Component -->
<div class="p-4 rounded-2xl hover:border-primary/20 relative transition-all cursor-pointer bg-white group">
    <div class="flex items-center gap-4 mb-4">
        <div class="p-2.5 <%= className %> rounded-lg group-hover:bg-primary group-hover:text-white transition-all">
            <%- icon %>
        </div>
        <div class="flex-1 overflow-hidden">
            <h4 class="font-bold text-slate-900 text-sm truncate"><%= title %></h4>
            <p class="text-[10px] text-slate-400"><%= label %> • <%= size %></p>
        </div>
    </div>
    <div class="flex justify-between text-[10px] text-slate-400">
        <span><%= fileCount %></span>
        <span><%= updated %></span>
    </div>

    <a href="<%= route %>" class="absolute inset-0 z-10"></a>
</div>
