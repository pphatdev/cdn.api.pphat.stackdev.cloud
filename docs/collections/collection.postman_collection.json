              "path": ["image", "assets", ":filename"],
              "query": [
                {
                  "key": "fm",
                  "value": "webp",
                  "description": "Format: jpg, png, webp, avif"
                },
                {
                  "key": "q",
                  "value": "80",
                  "description": "Quality: 1-100"
                },
                {
                  "key": "w",
                  "value": "500",
                  "description": "Width in pixels"
                },
                {
                  "key": "h",
                  "value": "500",
                  "description": "Height in pixels"
                },
                {
                  "key": "fit",
                  "value": "cover",
                  "description": "cover, contain, fill, inside, outside"
                }
              ],
              "variable": [
                {
                  "key": "filename",
                  "value": "example.jpg"
                }
              ]
            },
            "description": "Retrieve and optimize images with real-time transformations.\n\n**Features:**\n- Format conversion (WebP, AVIF, JPEG, PNG)\n- Resize and crop\n- Quality optimization\n- Automatic caching"
