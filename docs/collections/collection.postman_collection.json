              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"currentPassword\": \"admin123\",\n    \"newPassword\": \"NewSecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{url}}/auth/change-password",
              "host": ["{{url}}"],
              "path": ["auth", "change-password"]
            },
            "description": "Change user password. Invalidates all other sessions.\n\n**Password Requirements:**\n- Minimum 8 characters\n- At least one uppercase letter\n- At least one lowercase letter\n- At least one number"
          },
          "response": []
        },
        {
          "name": "Get Active Sessions",
          "request": {
            "method": "GET",
