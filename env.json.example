{
    "app": {
        "name": "CDN API",
        "env": "development"
    },
    "port": 3000,
    "directories": [
        "./storage/**/**"
    ],
    "allow": {
        "origins": [
            "http://localhost:3000",
            "http://localhost:5173"
        ],
        "patterns": [
            "^https?://.*\\.stackdev\\.cloud$"
        ]
    }
}